# PostgreSQL (shared with pco-mcp — use the same password in both .env files)
# Set your password here, then paste the same value into DATABASE_URL below
POSTGRES_PASSWORD=""
# For local dev: localhost | For Docker: pco-mcp-db
DATABASE_URL="postgresql://pco:YOUR_PASSWORD_HERE@localhost:5432/pco_mcp?schema=agent"

# Planning Center OAuth
PCO_CLIENT_ID=""
PCO_CLIENT_SECRET=""

# NextAuth
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# pco-mcp server URL (defaults to pco-mcp.com/mcp if not set)
PCO_MCP_URL="https://pco-mcp.com/mcp"

# Fernet encryption key for API keys at rest
ENCRYPTION_KEY=""  # Generate with: node -e "const {Fernet}=require('fernet-nodejs');console.log(Fernet.generateKey())"

# Optional: log level (default: info)
# LOG_LEVEL="info"
